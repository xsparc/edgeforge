{
  "components": {
    "schemas": {
      "BenchmarkOptions": {
        "additionalProperties": false,
        "properties": {
          "atol": {
            "default": 1e-05,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Atol",
            "type": "number"
          },
          "iterations": {
            "default": 50,
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Iterations",
            "type": "integer"
          },
          "rtol": {
            "default": 0.0001,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Rtol",
            "type": "number"
          },
          "warmup": {
            "default": 5,
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Warmup",
            "type": "integer"
          }
        },
        "title": "BenchmarkOptions",
        "type": "object"
      },
      "BenchmarkReport": {
        "additionalProperties": false,
        "properties": {
          "active_providers": {
            "items": {
              "type": "string"
            },
            "title": "Active Providers",
            "type": "array"
          },
          "agreement": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ]
            },
            "title": "Agreement",
            "type": "object"
          },
          "bundle_sha256": {
            "title": "Bundle Sha256",
            "type": "string"
          },
          "cases": {
            "title": "Cases",
            "type": "integer"
          },
          "device": {
            "additionalProperties": true,
            "title": "Device",
            "type": "object"
          },
          "edgeforge_version": {
            "title": "Edgeforge Version",
            "type": "string"
          },
          "latency_ms": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Latency Ms",
            "type": "object"
          },
          "measured_at": {
            "title": "Measured At",
            "type": "string"
          },
          "measurement_scope": {
            "title": "Measurement Scope",
            "type": "string"
          },
          "memory": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ]
            },
            "title": "Memory",
            "type": "object"
          },
          "options": {
            "$ref": "#/components/schemas/BenchmarkOptions"
          },
          "requested_provider": {
            "title": "Requested Provider",
            "type": "string"
          },
          "runtime": {
            "title": "Runtime",
            "type": "string"
          },
          "runtime_version": {
            "title": "Runtime Version",
            "type": "string"
          },
          "schema_version": {
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "storage": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Storage",
            "type": "object"
          },
          "threads": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Threads"
          }
        },
        "required": [
          "edgeforge_version",
          "bundle_sha256",
          "measured_at",
          "runtime",
          "runtime_version",
          "requested_provider",
          "active_providers",
          "threads",
          "options",
          "cases",
          "latency_ms",
          "memory",
          "storage",
          "agreement",
          "device",
          "measurement_scope"
        ],
        "title": "BenchmarkReport",
        "type": "object"
      },
      "BenchmarkRequest": {
        "additionalProperties": false,
        "properties": {
          "bundle_id": {
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
            "title": "Bundle Id",
            "type": "string"
          },
          "options": {
            "$ref": "#/components/schemas/BenchmarkOptions"
          }
        },
        "required": [
          "bundle_id"
        ],
        "title": "BenchmarkRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "EdgeForge",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "health_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/v1/benchmarks": {
      "post": {
        "operationId": "measure_v1_benchmarks_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BenchmarkRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BenchmarkReport"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Measure"
      }
    },
    "/v1/bundles": {
      "get": {
        "operationId": "bundles_v1_bundles_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Bundles"
      }
    },
    "/v1/capabilities": {
      "get": {
        "operationId": "device_v1_capabilities_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Device"
      }
    }
  }
}
